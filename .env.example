# Copy these into Vercel → Project → Settings → Environment Variables
# (or your host's equivalent). Never commit real values.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DEBUG defaults to False on Vercel and True locally; override only if needed.
# DJANGO_DEBUG=False

# Postgres connection string (Vercel Storage → Postgres/Neon adds this automatically)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Your own domain(s); *.vercel.app is allowed automatically on Vercel
DJANGO_ALLOWED_HOSTS=mbuzimunch.com,www.mbuzimunch.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mbuzimunch.com,https://www.mbuzimunch.com

# Booking and job-application emails
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mbuzi Munch <no-reply@mbuzimunch.com>
CAREERS_EMAIL=galleria@mbuzimunch.com
