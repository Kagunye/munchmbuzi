{
  "version": 2,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "excludeFiles": "{.venv,static,media,staticfiles_build,tools,docs}/**"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles_build" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/media/(.*)", "dest": "/media/$1", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "config/wsgi.py" }
  ]
}
